+.add-product-page {
+    width: min(1000px, calc(70% - 96px));
+    margin: 40px auto 140px;
+    flex: 1;
+}
+
+.page-heading {
+    margin-bottom: 30px;
+}
+
+.page-heading h1 {
+    margin: 0 0 12px;
+    color: #242424;
+    font-family: Georgia, "Times New Roman", serif;
+    font-weight: normal;
+    font-size: 50px;
+    line-height: 1;
+    letter-spacing: -1.5px;
+}
+
+.page-heading p {
+    margin: 0;
+    color: #6d6962;
+    font-size: 20px;
+}
+
+.product-form {
+    background: #ffffff;
+    border: 1px solid #dedbd4;
+    border-radius: 4px;
+    padding: 50px;
+}
+
+.form-row {
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 28px;
+    margin-bottom: 32px;
+}
+
+.form-field {
+    display: flex;
+    flex-direction: column;
+}
+
+.form-field.full-width {
+    grid-column: 1 / -1;
+}
+
+.form-field label {
+    margin-bottom: 12px;
+    color: #6d6962;
+    font-size: 20px;
+}
+
+.form-field input,
+.form-field select,
+.form-field textarea {
+    width: 100%;
+    padding: 18px;
+    border: 1px solid #dedbd4;
+    border-radius: 4px;
+    background: #ffffff;
+    color: #242424;
+    font-size: 20px;
+    font-family: inherit;
+    outline: none;
+    transition: border-color 0.2s ease;
+}
+
+.form-field input,
+.form-field select {
+    height: 62px;
+}
+
+.form-field textarea {
+    min-height: 160px;
+    resize: vertical;
+    line-height: 1.5;
+}
+
+.form-field input::placeholder,
+.form-field textarea::placeholder {
+    color: #9c9891;
+}
+
+.form-field input:focus,
+.form-field select:focus,
+.form-field textarea:focus {
+    border-color: #242424;
+    box-shadow: 0 0 0 3px rgba(36, 36, 36, 0.08);
+}
+
+.image-upload {
+    display: flex;
+    align-items: center;
+    gap: 20px;
+}
+
+.image-preview {
+    width: 80px;
+    height: 80px;
+    object-fit: cover;
+    border-radius: 4px;
+    border: 1px solid #dedbd4;
+}
+
+.color-field {
+    display: flex;
+    align-items: center;
+    gap: 16px;
+}
+
+.color-field input[type="color"] {
+    width: 62px;
+    height: 62px;
+    padding: 4px;
+    cursor: pointer;
+}
+
+.color-field span {
+    color: #6d6962;
+}
+
+.error {
+    margin-top: 7px;
+    color: #b44d42;
+    font-size: 14px;
+}
+
+.form-actions {
+    display: flex;
+    gap: 18px;
+    margin-top: 40px;
+}
+
+.primary-button,
+.secondary-button {
+    padding: 17px 34px;
+    border-radius: 4px;
+    font-size: 20px;
+    font-family: inherit;
+    font-weight: 600;
+    cursor: pointer;
+    transition: all 0.2s ease;
+}
+
+.primary-button {
+    border: 1px solid #242424;
+    background: #242424;
+    color: #ffffff;
+}
+
+.secondary-button {
+    border: 1px solid #dedbd4;
+    background: #ffffff;
+    color: #242424;
+}
+
+.primary-button:hover {
+    background: #3d3a36;
+    border-color: #3d3a36;
+}
+
+.secondary-button:hover {
+    background: #f7f5f0;
+    border-color: #c8bfb5;
+}
+
+.success-toast {
+    margin-top: 20px;
+    padding: 14px 18px;
+    border-radius: 4px;
+    background: #edf5ef;
+    color: #3f6848;
+    font-size: 16px;
+    animation: slideIn 0.3s ease;
+}
+
+@keyframes slideIn {
+    from {
+        opacity: 0;
+        transform: translateY(-10px);
+    }
+    to {
+        opacity: 1;
+        transform: translateY(0);
+    }
+}
+
+@media (max-width: 700px) {
+    .add-product-page {
+        width: calc(100% - 32px);
+        margin: 45px auto 80px;
+    }
+
+    .page-heading h1 {
+        font-size: 40px;
+    }
+
+    .page-heading p {
+        font-size: 17px;
+    }
+
+    .product-form {
+        padding: 28px 20px;
+    }
+
+    .form-row {
+        grid-template-columns: 1fr;
+        gap: 25px;
+        margin-bottom: 25px;
+    }
+
+    .form-actions {
+        flex-direction: column;
+    }
+
+    .primary-button,
+    .secondary-button {
+        width: 100%;
+    }
+}
